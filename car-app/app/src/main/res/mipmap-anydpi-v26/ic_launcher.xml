<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). The device launcher supplies its own
     mask/shape; we only provide a light background, the 声纹 foreground, and a
     monochrome layer for Android 13+ themed icons. API 25 and below — and any
     launcher that ignores adaptive icons — fall back to the PNGs in mipmap-*. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
