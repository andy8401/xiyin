        android:pathData="M 54,39.7 a 14.3,14.3 0 1,1 0,28.6 a 14.3,14.3 0 1,1 0,-28.6"
        android:strokeColor="#9EA8801C"
        android:strokeWidth="1.9"
        android:fillColor="@android:color/transparent" />
